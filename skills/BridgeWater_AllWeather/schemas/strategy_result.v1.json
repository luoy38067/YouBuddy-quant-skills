{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "strategy_result.v1",
  "type": "object",
  "required": ["contract", "status", "run_id", "summary", "output_files"],
  "properties": {
    "contract": {"const": "strategy_result.v1"},
    "status": {"const": "computed", "description": "Python 只能声明 computed；done 由宿主 commit 写入"},
    "run_id": {"type": "string"},
    "summary": {
      "type": "object",
      "properties": {
        "strategy": {"type": "object"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "total_return": {"type": "number"},
        "annualized_return": {"type": "number"},
        "max_drawdown": {"type": "number"},
        "sharpe": {"type": "number"},
        "benchmark_total_return": {"type": "number"},
        "trading_days": {"type": "integer"},
        "trade_count": {"type": "integer"},
        "rebalance_events": {"type": "integer"},
        "fee_total": {"type": "number"}
      }
    },
    "output_files": {
      "type": "array",
      "items": {"type": "string"},
      "description": "staging 内产物文件名（宿主 validate/commit 接管）"
    }
  },
  "additionalProperties": false
}
