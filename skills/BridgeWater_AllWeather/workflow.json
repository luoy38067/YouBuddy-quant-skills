{
  "version": 2,
  "kind": "strategy_backtest",
  "params": [
    {
      "name": "start",
      "type": "date",
      "default": "2024-01-02",
      "description": "回测开始日期"
    },
    {
      "name": "end",
      "type": "date",
      "default": "2026-11-10",
      "description": "回测结束日期"
    },
    {
      "name": "universe",
      "type": "enum",
      "default": "CUSTOM",
      "enum_values": [
        "CUSTOM"
      ],
      "description": "资产池（固定四只 ETF，行情由宿主提供）"
    },
    {
      "name": "benchmark",
      "type": "string",
      "default": "000300",
      "description": "基准指数代码（沪深300）"
    }
  ],
  "constraints": [
    {
      "rule": "lt",
      "left": "start",
      "right": "end"
    }
  ],
  "strategy": {
    "id": "BridgeWater_AllWeather",
    "name": "桥水全天候策略",
    "family": "risk_parity",
    "version": "2.0.0",
    "asset_class": "fund",
    "direction": "long_only",
    "tags": [
      "risk_parity",
      "asset_allocation",
      "scheduled",
      "weekly",
      "etf"
    ]
  },
  "rebalance": {
    "mode": "scheduled",
    "frequency": "weekly",
    "calendar_rule": "weekly_first_trading_day",
    "signal_timing": "close",
    "execution_timing": "next_open"
  },
  "steps": [
    {
      "id": "build_dataset",
      "type": "dataset",
      "builder": "multi_asset_backtest_bundle.v1",
      "label": "构建回测数据集（交易日历/ETF 行情/基准行情）",
      "args": [
        {
          "start": "${input.start}",
          "end": "${input.end}",
          "warmup_trading_days": 140,
          "universe": "CUSTOM",
          "custom_tickers": "515220,511260,518880,512890",
          "benchmark": "${input.benchmark}",
          "adjustment": "forward",
          "asset_class": "etf",
          "execution_price_type": "next_open"
        }
      ]
    },
    {
      "id": "run_backtest",
      "type": "python_hook",
      "hook": "run_backtest",
      "label": "运行桥水全天候策略回测"
    },
    {
      "id": "validate_outputs",
      "type": "validate",
      "contract": "strategy_backtest.v1",
      "label": "校验回测产物（strategy_backtest.v1）"
    },
    {
      "id": "commit_run",
      "type": "commit",
      "label": "原子提交回测产物"
    }
  ]
}
