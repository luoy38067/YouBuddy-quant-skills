{
  "version": 1,
  "variables": [
    {
      "kind": "input_date",
      "name": "as_of",
      "default": "today"
    },
    {
      "kind": "date_offset",
      "name": "win_s",
      "from": "as_of",
      "days": -30
    },
    {
      "kind": "date_offset",
      "name": "stats_s",
      "from": "as_of",
      "days": -7
    },
    {
      "kind": "date_offset",
      "name": "mf_s",
      "from": "as_of",
      "days": -4
    },
    {
      "kind": "date_offset",
      "name": "q1_s",
      "from": "as_of",
      "days": -4
    },
    {
      "kind": "date_offset",
      "name": "q2_s",
      "from": "as_of",
      "days": -9
    },
    {
      "kind": "date_offset",
      "name": "q2_e",
      "from": "as_of",
      "days": -5
    },
    {
      "kind": "date_offset",
      "name": "q3_s",
      "from": "as_of",
      "days": -14
    },
    {
      "kind": "date_offset",
      "name": "q3_e",
      "from": "as_of",
      "days": -10
    },
    {
      "kind": "date_offset",
      "name": "q4_s",
      "from": "as_of",
      "days": -19
    },
    {
      "kind": "date_offset",
      "name": "q4_e",
      "from": "as_of",
      "days": -15
    },
    {
      "kind": "date_offset",
      "name": "q5_s",
      "from": "as_of",
      "days": -24
    },
    {
      "kind": "date_offset",
      "name": "q5_e",
      "from": "as_of",
      "days": -20
    },
    {
      "kind": "date_offset",
      "name": "q6_s",
      "from": "as_of",
      "days": -29
    },
    {
      "kind": "date_offset",
      "name": "q6_e",
      "from": "as_of",
      "days": -25
    },
    {
      "kind": "literal",
      "name": "min_board",
      "value": 2
    }
  ],
  "steps": [
    {
      "id": "cons_std",
      "type": "builtin",
      "tool": "app_dq_index_constituents_by_name",
      "label": "[v0.3.5] 1/15 取创业板成分（宿主编排前置步骤，compute 不消费）",
      "args": [
        {
          "index_name": "创业板",
          "date": "${as_of}"
        }
      ]
    },
    {
      "id": "limit_ind_up_export",
      "type": "builtin",
      "tool": "app_dq_export",
      "label": "[v0.3.5] 2/15 导出涨停明细（LIMIT_TYPE=01，30 自然日窗口整表 ≈20 交易日，连板计数本地做）",
      "args": [
        {
          "database": "tl_stock_quote",
          "table_name": "mkt_limit_ind",
          "cond": {
            "LIMIT_TYPE": [
              "01"
            ]
          },
          "cond_range": {
            "TRADE_DATE": {
              "$gte": "${win_s}",
              "$lte": "${as_of}"
            }
          },
          "cols": [
            "TICKER_SYMBOL",
            "TRADE_DATE",
            "LIMIT_TYPE",
            "LIMIT_PRICE",
            "FIRST_LIMIT_TIME",
            "LIMIT_VALUE_CLOSE",
            "LIMIT_VALUE_MAX"
          ],
          "order_by": "TRADE_DATE",
          "order_method": "desc",
          "offset": 0,
          "limit": 24000,
          "max_rows": 24000
        },
        "csv",
        ".data/${run_id}_limit_ind.csv"
      ]
    },
    {
      "id": "limit_ind_down_export",
      "type": "builtin",
      "tool": "app_dq_export",
      "label": "[v0.3.5] 3/15 导出跌停明细（LIMIT_TYPE=02，同窗口；空结果降级为数据不足）",
      "args": [
        {
          "database": "tl_stock_quote",
          "table_name": "mkt_limit_ind",
          "cond": {
            "LIMIT_TYPE": [
              "02"
            ]
          },
          "cond_range": {
            "TRADE_DATE": {
              "$gte": "${win_s}",
              "$lte": "${as_of}"
            }
          },
          "cols": [
            "TICKER_SYMBOL",
            "TRADE_DATE",
            "LIMIT_TYPE",
            "LIMIT_PRICE",
            "LIMIT_VALUE_CLOSE"
          ],
          "order_by": "TRADE_DATE",
          "order_method": "desc",
          "offset": 0,
          "limit": 8000,
          "max_rows": 8000
        },
        "csv",
        ".data/${run_id}_limit_ind_down.csv"
      ]
    },
    {
      "id": "quotes_p1",
      "type": "builtin",
      "tool": "app_dq_export",
      "label": "[v0.3.5] 4/15 行情切片 1/6（as_of-4..as_of，全市场 30 自然日 ≈11.3 万行必须切片，单片 <24000）",
      "args": [
        {
          "database": "tl_stock_quote",
          "table_name": "mkt_equd",
          "cond_range": {
            "TRADE_DATE": {
              "$gte": "${q1_s}",
              "$lte": "${as_of}"
            }
          },
          "cols": [
            "TICKER_SYMBOL",
            "TRADE_DATE",
            "CLOSE_PRICE",
            "ACT_PRE_CLOSE_PRICE",
            "CHG_PCT",
            "TURNOVER_VALUE",
            "TURNOVER_RATE",
            "NEG_MARKET_VALUE"
          ],
          "order_by": "TRADE_DATE",
          "order_method": "desc",
          "offset": 0,
          "limit": 24000,
          "max_rows": 24000
        },
        "csv",
        ".data/${run_id}_equd_quotes_p1.csv"
      ]
    },
    {
      "id": "quotes_p2",
      "type": "builtin",
      "tool": "app_dq_export",
      "label": "[v0.3.5] 5/15 行情切片 2/6（as_of-9..as_of-5）",
